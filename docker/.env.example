# qiuqiuwriter Docker 部署环境变量
# 复制为 .env 后按需修改：cp .env.example .env

# ---------- 应用安全 ----------
ENVIRONMENT=development
SECRET_KEY=example-placeholder-do-not-use
BACKEND_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:8889"]'
ALLOWED_HOSTS='["localhost","127.0.0.1","0.0.0.0"]'

# ---------- PostgreSQL ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example-placeholder-do-not-use
POSTGRES_DB=writerai
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379
# 生产 compose (docker-compose.prod.yml) 通过 ${REDIS_PASSWORD:?} 强制要求该值，
# 复制 .env.example 为 .env 后用于生产部署时必须改为强随机值，否则 backend 启动报错。
REDIS_PASSWORD=example-placeholder-do-not-use

# ---------- MongoDB ----------
MONGODB_DATABASE=writerai_sharedb
MONGODB_PORT=27017
# 生产 compose 通过 ${MONGODB_USERNAME:?} / ${MONGODB_PASSWORD:?} 强制要求，
# 生产部署时必须显式设置强凭证。
MONGODB_USERNAME=example-placeholder-do-not-use
MONGODB_PASSWORD=example-placeholder-do-not-use

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=example-placeholder-do-not-use

# ---------- MinIO ----------
MINIO_ACCESS_KEY=example-placeholder-do-not-use
MINIO_SECRET_KEY=example-placeholder-do-not-use

# ---------- 后端（仅在后端以容器方式启动时生效） ----------
BACKEND_PORT=8000

# ---------- 应用连接说明 ----------
# 本机跑应用、仅用 Docker 起中间件时，在应用 .env 中使用：
#   POSTGRES_HOST=127.0.0.1  REDIS_HOST=localhost  MONGODB_HOST=localhost
# 应用也跑在 Docker（docker compose up）时，上述已在 compose 中写死为服务名：
#   POSTGRES_HOST=postgres  REDIS_HOST=redis  MONGODB_HOST=mongodb
